# Порт, на котором слушает сервис.
PORT=8080
# Базовый адрес, из которого собирается short_url.
BASE_URL=http://localhost:8080
# Подключение к PostgreSQL.
DATABASE_URL=postgres://links:secret@localhost:5432/links?sslmode=disable
# Мониторинг ошибок. Пустая переменная просто выключает его.
SENTRY_DSN=
